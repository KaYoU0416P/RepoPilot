# Copy to .env.  Without a key, set REPOPILOT_LLM_PROVIDER=scripted to run offline.
REPOPILOT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
REPOPILOT_MODEL=claude-sonnet-4-6
REPOPILOT_MAX_RETRIES=2
REPOPILOT_TOOL_TIMEOUT_SECONDS=20
REPOPILOT_TEST_TIMEOUT_SECONDS=60
REPOPILOT_MAX_CONCURRENT_TOOLS=4
