# Copy to .env.  Without a key, the provider degrades to `scripted` (offline, free).
#
# 只设 provider + key 就够了 —— model 会跟着 provider 走（见 config.py::DEFAULT_MODELS）。
# 显式设了 REPOPILOT_MODEL 就永远以你设的为准。

# --- 选一个 provider ---

# Anthropic
# REPOPILOT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek（OpenAI 兼容；便宜一个数量级，缓存自动生效）
# 换 Qwen / Kimi / GLM 也是同一个客户端，改 REPOPILOT_DEEPSEEK_BASE_URL + MODEL
REPOPILOT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-...
# REPOPILOT_MODEL=deepseek-v4-pro        # 不设就是这个
# REPOPILOT_MODEL=deepseek-v4-flash      # 便宜 3 倍，改代码任务可能不够用

# --- Agent 预算 ---
REPOPILOT_MAX_RETRIES=2
REPOPILOT_TOOL_TIMEOUT_SECONDS=20
REPOPILOT_TEST_TIMEOUT_SECONDS=60
REPOPILOT_MAX_CONCURRENT_TOOLS=4

# --- 可观测 ---
# REPOPILOT_OTEL_ENABLED=true            # span 打到 stderr；make trace 会临时打开
